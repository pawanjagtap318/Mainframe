//DB2COPY  JOB (ACCT),'COREVISTA COPY',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//* REFERENCE IMAGE COPY OF THE ACCOUNT TABLESPACE
//COPY     EXEC PGM=DSNUTILB,REGION=0M,
//         PARM='DB2P,DB2COPY'
//STEPLIB  DD  DSN=DSNC10.SDSNLOAD,DISP=SHR
//SYSIN    DD  *
  COPY TABLESPACE AETHR.TSACCT
       COPYDDN(SYSCOPY)
       SHRLEVEL REFERENCE
/*
//SYSCOPY  DD  DSN=AETHR.COPY.TSACCT(+1),
//         DISP=(NEW,CATLG,DELETE),
//         SPACE=(CYL,(5,2)),UNIT=SYSDA
//SYSPRINT DD  SYSOUT=*
//SYSUT1   DD  UNIT=SYSDA,SPACE=(CYL,(5,2))
